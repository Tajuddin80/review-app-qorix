{%- assign display_rating = rating | default: 4.9 -%}

{% style %}
  .shopify-app-block[data-block-handle='ReviewHub'] {
    display: block;
    width: 100%;
  }

  .qr-review-hub {
    padding: 40px 20px;
  }
  .qr-heading-wrapper {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .qr-heading-label {
    color: #34c759;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .qr-heading-title {
    font-size: 32px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 16px;
  }
  .qr-heading-subtitle {
    color: #303030;
    font-size: 16px;
    font-weight: 400;
    margin: 0 0 24px;
  }
  .qr-rating-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .qr-rating-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .qr-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .qr-rating-score {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 15px;
  }
  .qr-rating-count {
    color: #616161;
    font-size: 14px;
  }
  .qr-rating-divider {
    color: #d1d5db;
  }
  .qr-verified-badge {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 16px;
    font-weight: 400;
    color: #616161;
  }

  .qr-reviews-section {
    max-width: 1100px;
    margin: 40px auto 0;
  }
{% endstyle %}


<div class="qr-heading-wrapper">
  <p class="qr-heading-label">{{ label | default: 'Customer Reviews' }}</p>
  <h2 class="qr-heading-title">{{ title | default: 'What customers love about us' }}</h2>
  <p class="qr-heading-subtitle">{{ subtitle | default: 'Watch and hear what our customers have to say.' }}</p>

  <div class="qr-rating-summary">
    <div class="qr-rating-stars">
      {% render 'stars', rating: display_rating %}
    </div>
    <span class="qr-rating-score">{{ display_rating }}</span>
    <span class="qr-rating-count">({{ review_count | default: 2451 }} reviews)</span>
    <span class="qr-rating-divider">|</span>
    <span class="qr-verified-badge">
      <svg width="22" height="19" viewBox="0 0 22 19" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M15.157 18.15H1.7207C0.556249 18.15 -0.273047 17.0156 0.0835931 15.907L1.49726 11.4898C1.95273 10.0719 3.50391 9.33711 4.8875 9.87422C5.80703 10.2309 6.98867 10.5102 8.43672 10.5102C9.88476 10.5102 11.0664 10.2309 11.9859 9.87422C12.0375 9.85273 12.0934 9.83555 12.1492 9.81836V9.92578C12.1492 12.4652 14.0355 14.5707 16.4805 14.9145L16.7984 15.907C17.1508 17.0156 16.3258 18.15 15.157 18.15ZM8.44101 0C5.99609 0 4.01094 1.98516 4.01094 4.43008C4.01094 6.875 5.99609 8.86016 8.44101 8.86016C10.8859 8.86016 12.8711 6.875 12.8711 4.43008C12.8711 1.98516 10.8859 0 8.44101 0ZM21.366 9.92148C21.366 12.2289 19.4969 14.1023 17.1852 14.1023C14.8777 14.1023 13.0043 12.2332 13.0043 9.92148C13.0043 7.60977 14.8777 5.74062 17.1852 5.74062C19.4926 5.74492 21.366 7.61406 21.366 9.92148ZM19.7633 7.95781C19.4668 7.66133 18.9855 7.66133 18.6891 7.95781L16.3687 10.2781L15.6855 9.59492C15.3891 9.29844 14.9078 9.29844 14.6113 9.59492C14.3148 9.89141 14.3148 10.3727 14.6113 10.6691L15.8316 11.8895C16.1281 12.1859 16.6094 12.1859 16.9059 11.8895L19.7676 9.02773C20.0598 8.73555 20.0598 8.2543 19.7633 7.95781Z"
          fill="url(#paint0_linear_6372_2050)" />
        <defs>
          <linearGradient id="paint0_linear_6372_2050" x1="2.31152" y1="4.29438" x2="16.0188" y2="18.0017"
